# ─── BhashaSetu AI — Environment Variables ───────────────────────────────────
# Copy to .env for local development; do NOT commit .env to version control.

# ── App ────────────────────────────────────────────────────────────────────
APP_NAME=BhashaSetu AI
ENVIRONMENT=development
DEBUG=true

# ── Database ───────────────────────────────────────────────────────────────
# Local dev (plain postgres://) — the app converts to asyncpg format at startup
DATABASE_URL=postgresql://bhashasetu:bhashasetu_dev@localhost:5432/bhashasetu
POSTGRES_USER=bhashasetu
POSTGRES_PASSWORD=bhashasetu_dev
POSTGRES_DB=bhashasetu

# ── Redis ──────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# ── Auth ───────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production-use-32-random-bytes

# ── AI ─────────────────────────────────────────────────────────────────────
# Gemini API key — get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ── Payments (optional) ────────────────────────────────────────────────────
# Get from https://dashboard.razorpay.com/
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Google Cloud (optional — for TTS/STT) ─────────────────────────────────
# Base64-encoded service account JSON
# GOOGLE_CLOUD_CREDENTIALS=
